# Copy to .env (never committed). On the server: /home/deploy/readly/.env

# Stripe test mode secret key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...

# Anthropic API key for practice-story generation (optional: without it the library stories are used)
ANTHROPIC_API_KEY=sk-ant-...

# Base URL for Stripe redirects (prod: https://readly.13lab.tech)
SITE_URL=http://localhost:3000

# Resend key for email sign-in links (resend.com → API keys). Without it, dev prints the link on screen.
RESEND_API_KEY=

# Sender for sign-in emails (domain must be verified in Resend)
EMAIL_FROM=Readly <readly@13lab.tech>

# SQLite file for accounts and synced progress (Docker image default: /app/var/readly.db)
DATABASE_PATH=./var/readly.db
