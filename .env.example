# Copy to .env.local (never committed) and fill in. On Vercel: Project → Settings → Environment Variables.
# Server-only secrets: never prefix with NEXT_PUBLIC_.

# Stripe test mode secret key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_test_...

# Anthropic API key for practice-story generation (optional: without it the library stories are used)
ANTHROPIC_API_KEY=sk-ant-...

# Public base URL for Stripe redirects (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
